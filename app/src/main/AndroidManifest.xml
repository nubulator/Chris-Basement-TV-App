
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="Chris' Basement TV" android:theme="@android:style/Theme.Material.NoActionBar" android:usesCleartextTraffic="false" android:networkSecurityConfig="@xml/network_security_config" android:banner="@drawable/tv_banner_safe" android:icon="@drawable/tv_icon_safe" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
